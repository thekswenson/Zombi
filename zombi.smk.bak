"""
Rules for running the Zombi simulator.

Note that, to prevent the simulations from accidentally being rerun, there
are lock files (e.g. lock_G.flag) that are saved in the simulation directory. To
rerun the simulation, remove the lock file.
(The reason for this is that different project should share the same
simulations so that the results are comparable.)
"""
import shutil

from pathlib import Path

from scripts.parameters import modParams, PDirNames
from scripts.parameters import getTreeParams, getGenomeParams, getSequenceParams

configfile: 'workflow/config/default.yaml'

#Config File Globals:
SIMDIR = str(Path(config.get('SIMDIR', 'simulations')))  #Remove trailing slash
MAX_THREADS = config.get('MAX_THREADS', 1)
REPS = int(config.get('REPS', 1))

#Access to config values
ZOMBI_P = config['ZOMBI']
ZOMBI_SEQP = ZOMBI_P['SEQUENCE']
ZOMBI_GENP = ZOMBI_P['GENOME']
ZOMBI_TREEP = ZOMBI_P['SPECIESTREE']

TPARAMS = PDirNames.TPARAMS.value
GPARAMS = PDirNames.GPARAMS.value
SPARAMS = PDirNames.SPARAMS.value

# Run Zombi 
#_______________________________________________________________________________

rule run_Zombi_T:
  """ Simulate trees. Remove the lock file to rerun! """
  input:
    paramfile = SIMDIR + '/trees/{tparams}/{rep}/parameters/SpeciesTreeParameters.tsv',

  output:
    directory(SIMDIR + '/trees/{tparams}/{rep}/T'),
    SIMDIR + '/trees/{tparams}/{rep}/T/ExtantTree.nwk',

  log:
    SIMDIR + '/trees/{tparams}/{rep}/logs/T.log'

  run:
    lockfile = Path(SIMDIR + f'/trees/{wildcards.tparams}/{wildcards.rep}/lock_T.flag')
    if lockfile.exists():
      raise WorkflowError((f'Simulation protected by lockfile. Use -t, or to rerun remove "{lockfile}"'))

      #Run the simulation
    shell('Zombi T {input.paramfile} ' + SIMDIR +
          '/trees/{wildcards.tparams}/{wildcards.rep} &> {log}')
    shell('touch {lockfile}')


rule run_Zombi_G:
  """ Simulate genomes. Remove the lock file to rerun! """
  input:
    SIMDIR + '/trees/{tparams}/{rep}/T',
    paramfile = (SIMDIR + '/genomes/{tparams}/' + GPARAMS +
                 '{gparams}/{rep}/parameters/GenomeParameters.tsv'),

  output:
    directory(SIMDIR + '/genomes/{tparams}/' + GPARAMS + '{gparams}/{rep}/G'),
    directory(SIMDIR + '/genomes/{tparams}/' + GPARAMS + '{gparams}/{rep}/G/Genomes'),
    directory(SIMDIR + '/genomes/{tparams}/' + GPARAMS + '{gparams}/{rep}/G/Gene_families'),

  log:
    (SIMDIR + '/genomes/{tparams}/' + GPARAMS + '{gparams}/{rep}/logs/G.log')

  run:
    lockfile = Path(SIMDIR + f'/genomes/{wildcards.tparams}/{GPARAMS}'
                    f'{wildcards.gparams}/{wildcards.rep}/lock_G.flag')
    if lockfile.exists():
      raise WorkflowError((f'Simulation protected by lockfile. Use -t, or to rerun remove "{lockfile}"'))

      #Run the simulation
    shell('Zombi G {input.paramfile} ' + SIMDIR +
          '/genomes/{wildcards.tparams}/{GPARAMS}{wildcards.gparams}'
          '/{wildcards.rep} &> {log}')
    shell('touch {lockfile}')


rule run_Zombi_S:
  """ Simulate sequences. Remove the lock file to rerun! """
  input:
    SIMDIR + '/genomes/{tgparams}/{rep}/G',
    paramfile = (SIMDIR + '/sequences/{tgparams}/' + SPARAMS + 
                 '{sparams}/{rep}/parameters/SequenceParameters.tsv'),

  output:
    directory(SIMDIR + '/sequences/{tgparams}/' + SPARAMS +
              '{sparams}/{rep}/S/Genes'),

  log:
    SIMDIR + '/sequences/{tgparams}/' + SPARAMS + '{sparams}/{rep}/logs/S.log',

  threads:
    4       #Curently the S mode of Zombi only uses 4 threads maximum

  run:
    lockfile = Path(SIMDIR + f'/{wildcards.tgparams}/{SPARAMS}'
                    f'{wildcards.sparams}/{wildcards.rep}/lock_S.flag')
    if lockfile.exists():
      raise WorkflowError((f'Simulation protected by lockfile. Use -t, or to rerun remove "{lockfile}"'))

      #Run the simulation
    shell('Zombi S -p {threads} {input.paramfile} ' + SIMDIR +
          '/sequences/{wildcards.tgparams}/{SPARAMS}{wildcards.sparams}/'
          '{wildcards.rep} &> {log}')
    shell('touch {lockfile}')


rule Zombi_link_to_T:
  """ Create a symlink to the T directory in the genomes G directory.  """
  input:
    SIMDIR + '/trees/{tparams}/{rep}/T',

  output:
    SIMDIR + '/genomes/{tparams}/{GPARAMS}{gparams}/{rep}/T',

  run:
    Path(output).symlink_to(input)

rule Zombi_link_to_S:
  """ Create a symlink to the S directory in the genomes G directory.  """
  input:
    SIMDIR + '/sequences/{tgparams}/G',

  output:
    SIMDIR + '/genomes/{tgparams}/{SPARAMS}{sparams}/{rep}/G',

  run:
    Path(output).symlink_to(input)


# Create extra output files using ZombiExporter
#____________________________________________________________________________

rule Zombi_positional_orthologs:
  """
  Get the positional orthologs file from the Zombi output.
  """
  input:
    SIMDIR + '/genomes/{gparams}/{rep}/G/Gene_families',

  output:
    SIMDIR + '/genomes/{gparams}/{rep}/positional_orthologs-z_orig.json',

  shell:
    'ZombiExporter po ' + SIMDIR + '/{wildcards.gparams}/{wildcards.rep} {output}'


rule make_Zombi_duplications_file:
  """
  Create the duplications file for the Zombi output.
  """
  input:
    SIMDIR + '/genomes/{gparams}/{rep}/G/Genomes',

  output:
    SIMDIR + '/genomes/{gparams}/{rep}/duplication_counts_orig.tsv',

  run:
    shell('ZombiExporter dupinfo ' + SIMDIR + '/{wildcards.gparams}/{wildcards.rep} {output}')


