def seed_generators(seed: int|str, seed_file: Path, seed_function: Callable):
    """
    Seed a random generator and save the seed to a file. If `seed` is 0, a
    random seed is generated.
    """
    seed = int(seed)
    if seed == 0:
        seed = random.randint(1, sys.maxsize)

    print(f"Using seed {seed}")
    seed_function(seed)

    with open(seed_file, "w") as f:
        f.write(str(seed) + "\n")


def simulate_sequences_on_tree(tree_file: str, gene_trees_folder: Path,
                               outfolder: Path,
                               seq_sim: SequenceSimulator,
                               family_lens: dict[str, int],
                               id_to_seq: Optional[dict[str, SeqRecord]]=None,
                               verbose: bool=False) -> None:
    """
    Create a fasta file containing all the evolved sequences for the nodes of
    the tree in `tree_file`.

    Parameters
    ----------
    tree_file : str
        the tree to evolve sequences over
    gene_trees_folder : str
        the directory where you find the tree_file
    outfolder : str
        write a the new fasta file to this directory
    seq_sim : SequenceSimulator
        simulated the sequences using this object
    family_lens : dict[str, int]
        map genome or division family id to sequence length
    id_to_seq : Optional[dict[str, SeqRecord]], optional
        map genome or division family id to sequence
    """
    family = tree_file.split("_")[0]

    tree_path = gene_trees_folder / tree_file
    if verbose:
        print("Simulating sequence for family %s" % family)
                          #use fasta sequence
    if id_to_seq and family in id_to_seq:
        seq_sim.run_f(tree_path, family_lens[family], outfolder,
                      id_to_seq[family])

    else:                 #make random gene
        seq_sim.run_f(tree_path, family_lens[family], outfolder)

    af.write_pruned_sequences(str(tree_path).replace(COMPLETETREEsuffix, PRUNEDTREEsuffix),
                              outfolder)


#__    ___    ___    ___    ___    ___    ___    ___    ___    ___    ___    __
#  \__/   \__/   \__/   \__/   \__/   \__/   \__/   \__/   \__/   \__/   \__/


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(title='subcommands', dest='subparser',
                                       required=True)
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument('PARAMS', type=Path, help='Parameters TSV file')
    parent.add_argument('PROJECT_DIR', type=Path,
                        help='Name of the experiment directory')

    parent.add_argument('-f', '--force', action='store_true',
                        help='Overwrite existing files in PROJECT_DIR')

    Tdesc = 'Species Tree simulation'
    p_T = subparsers.add_parser('T', parents=[parent], description=Tdesc,
                                help=Tdesc)
    Tidesc = ('Species Tree simulation from input tree (PARAMS is a newick tree'
              'file rather than a parameters file)')
    p_Ti = subparsers.add_parser('Ti', parents=[parent], description=Tidesc,
                                 help=Tidesc)
    Tbdesc = 'Species Tree simulation with branch-wise rates'
    p_Tb = subparsers.add_parser('Tb', parents=[parent], description=Tbdesc,
                                 help=Tbdesc)
    Tpdesc = 'Species Tree simulation with lineage profiling'
    p_Tp = subparsers.add_parser('Tp', parents=[parent], description=Tpdesc,
                                 help=Tpdesc)
    Tmdesc = 'Species Tree simulation with mass extinctions'
    p_Tm = subparsers.add_parser('Tm', parents=[parent], description=Tmdesc,
                                 help=Tmdesc)
    Tsdesc = 'Species Tree simulation with a birth-death-shift process'
    p_Ts = subparsers.add_parser('Ts', parents=[parent], description=Tsdesc,
                                 help=Tsdesc)
    
    Gparent = argparse.ArgumentParser(add_help=False)
    Gdesc = 'Genome simulation'
    p_G = subparsers.add_parser('G', parents=[parent, Gparent],
                                description=Gdesc, help=Gdesc)
    Gudesc = 'Genome simulation with user-defined rates'
    p_Gu = subparsers.add_parser('Gu', parents=[parent, Gparent],
                                 description=Gudesc, help=Gudesc)
    Gfdesc = 'Genome simulation with intergenic sequences'
    p_Gf = subparsers.add_parser('Gf', parents=[parent, Gparent],
                                 description=Gfdesc, help=Gfdesc)
    Gmdesc = 'Genome simulation with gene family-wise rates'
    p_Gm = subparsers.add_parser('Gm', parents=[parent, Gparent],
                                 description=Gmdesc, help=Gmdesc)

    Sparent = argparse.ArgumentParser(add_help=False)
    Sparent.add_argument('-p', '--parallel', metavar='NUM_THREADS', type=int, default=1,
                         help='Use this many threads to simulated sequences')
    Sdesc = 'Sequence simulation'
    p_S = subparsers.add_parser('S', parents=[parent, Sparent],
                                description=Sdesc, help=Sdesc)
    Sudesc = 'Sequence simulation with user-defined rates'
    p_Su = subparsers.add_parser('Su', parents=[parent, Sparent],
                                 description=Sudesc, help=Sudesc)
    Sfdesc = 'Sequence simulation with intergenic sequence mutation'
    p_Sf = subparsers.add_parser('Sf', parents=[parent, Sparent],
                                 description=Sfdesc, help=Sfdesc)
    Ssdesc = 'Sequence simulation with shifting substitution rates'
    p_Ss = subparsers.add_parser('Ss', parents=[parent, Sparent],
                                 description=Ssdesc, help=Ssdesc)


    p_Gf.add_argument('-g', '--genome-root', metavar='GFF_FILE', type=Path,
                      help='Make the root genome have these gene intervals')
    p_Sf.add_argument('-s', '--sequence-root', metavar='FASTA_FILE', type=Path,
                      help='Seed the root genome with these ancestral sequences '
                           '(use after -g in Gf mode)')

    p_T.set_defaults(func=T_mode)
    p_Ti.set_defaults(func=T_mode)
    p_Tb.set_defaults(func=T_mode)
    p_Tp.set_defaults(func=T_mode)
    p_Tm.set_defaults(func=T_mode)
    p_Ts.set_defaults(func=T_mode)
    p_G.set_defaults(func=G_mode)
    p_Gu.set_defaults(func=G_mode)
    p_Gf.set_defaults(func=G_mode)
    p_Gm.set_defaults(func=G_mode)
    p_S.set_defaults(func=S_mode)
    p_Su.set_defaults(func=S_mode)
    p_Sf.set_defaults(func=S_mode)
    p_Ss.set_defaults(func=S_mode)

    args = parser.parse_args()
    if 'func' not in vars(args):
        parser.print_help()
        sys.exit() 

    args.func(args)


def T_mode(args):
    parameters_file = args.PARAMS
    experiment_folder = args.PROJECT_DIR
    force_overwrite = args.force
    advanced_mode = setAdvancedMode(args)
    Z = Zombi()

    t_folder = experiment_folder / "T"
    clear_directory(t_folder, force_overwrite)
    Z.T(parameters_file, experiment_folder, advanced_mode)


def G_mode(args):
    parameters_file = args.PARAMS
    experiment_folder = args.PROJECT_DIR
    force_overwrite = args.force
    advanced_mode = setAdvancedMode(args)

    root_gff = args.genome_root if hasattr(args, 'genome_root') else None
    Z = Zombi()

    genome_folder = experiment_folder / "G"
    clear_directory(genome_folder, force_overwrite)
    Z.G(parameters_file, experiment_folder, advanced_mode, root_gff)


def S_mode(args):
    parameters_file = args.PARAMS
    experiment_folder = args.PROJECT_DIR
    force_overwrite = args.force
    advanced_mode = setAdvancedMode(args)

    num_threads = args.parallel if hasattr(args, 'parallel') else 1
    root_fasta = args.sequence_root if hasattr(args, 'sequence_root') else None
    Z = Zombi()

    sequences_folder = experiment_folder / "S"
    clear_directory(sequences_folder, force_overwrite)
    Z.S(parameters_file, experiment_folder, advanced_mode, num_threads,
        root_fasta)


def setAdvancedMode(args):
    """
    Return the second letter of the mode, if there is one, otherwise return '0'.
    """
    mode = args.subparser
    if len(mode) == 1:
        return '0'

    elif len(mode) == 2:
        return mode[1]

    else:
        raise(ValueError('Unrecognized mode format for: "{mode}"'))
    

def clear_directory(directory: Path, force_overwrite: bool) -> None:
    if directory.exists() and not force_overwrite:
        sys.exit(f'Directory "{directory}" exists. Remove it, use -f, or '
                 f'choose another PROJECT_DIR')

    shutil.rmtree(directory, ignore_errors=True)
    directory.mkdir(parents=True)


if __name__ == "__main__":
    main()
