#!/usr/bin/env python3
import argparse
import os
import sys
import multiprocessing
import shutil
import random

from concurrent.futures import Future, ProcessPoolExecutor
from Bio.SeqRecord import SeqRecord
from typing import Callable, Optional
from pathlib import Path
from collections import defaultdict

import zombi.AuxiliarFunctions as af
from zombi.SpeciesTreeSimulator import SpeciesTreeGenerator
from zombi.GenomeSimulator import GenomeSimulator
from zombi.SequenceSimulator import SequenceSimulator, write_whole_genome
from zombi.Export import whole_genome_to_GFF
from zombi.Random import seed_G_generators, seed_S_generators, seed_T_generators
from zombi.Random import T_NPRNG
from zombi.Filenames import BRANCHWISERATES, CATEGORIES, GENEFAMILYLENGTHS
from zombi.Filenames import COMPLETETREEsuffix, PRUNEDTREEsuffix
from zombi.Filenames import GTSUBSTITUTIONRATES, RATES, RATESTREE
from zombi.Filenames import REDSCALEDEVENTS, REDSCALEDTREE, SCALEDEVENTS
from zombi.Filenames import SHIFTEVENTS, SHIFTSCATEGORIES, STSUBSTITUTIONRATES
from zombi.Filenames import SUBSTITUTIONSCALEDCOMPLETETREE
from zombi.Filenames import SUBSTITUTIONSCALEDEXTANTTREE, GENEFAMEVENTSsuffix
from zombi.Filenames import TREEEVENTS, PIECESsuffix, TSEED, GSEED, SSEED
from zombi.Filenames import SUBSTITUTIONSCALEDTREEsuffix
from zombi.Filenames import DIVISIONLENGTHS, COMPLETETREE, EXTANTTREE
from zombi.Filenames import COLLAPSEDNODES, TREELENGTHS, LEAVES, GENOMES
from zombi.Filenames import LEAFGENOMES, COMPLETEsuffix


class Zombi():

    def __init__(self):

        self.tree_parameters = dict()
        self.genome_parameters = dict()
        self.sequence_parameters = dict()

    def T(self, parameters_file: Path, experiment_folder: Path,
          advanced_mode: str):
        """
        Simulate the Species Tree
        """
        tree_folder = Path(experiment_folder) / "T"

        events_file = tree_folder / TREEEVENTS
        complete_tree_file = tree_folder / COMPLETETREE
        extant_tree_file = tree_folder / EXTANTTREE
        collapsed_nodes_file = tree_folder / COLLAPSEDNODES
        lengths_file = tree_folder / TREELENGTHS
        leaves_file = tree_folder / LEAVES

        shutil.rmtree(tree_folder)
        tree_folder.mkdir()

        if advanced_mode == "i":

            # In this case the input is a tree file
            tree_file = parameters_file
            print("Generate events for input file %s" % tree_file)

            stg = SpeciesTreeGenerator({})

            stg.start()
            stg.events = af.generate_events(tree_file)

        else:
            paramdict = af.read_parameters(parameters_file)

            seed_generators(paramdict["SEED"], tree_folder / TSEED,
                            seed_T_generators)

            parameters = af.prepare_species_tree_parameters(paramdict, T_NPRNG())

            stg = SpeciesTreeGenerator(parameters)

            shutil.copy(parameters_file, tree_folder)

            run_counter = 0
            success = False

            while not success and run_counter < 100:
                run_counter += 1
                print("Computing Species Tree. Trial number %s" % str(run_counter))
                if advanced_mode == "0":
                    success = stg.run()
                if advanced_mode == "b":
                    success = stg.run_b()
                if advanced_mode == "p":
                    success = stg.run_p()
                if advanced_mode == "m":
                    success = stg.run_m()
                if advanced_mode == "s":
                    success = stg.run_s()

            if run_counter >= 100:
                print("Aborting computation of the Species Tree after 100 tries. Please use other speciation and extinction rates!")
                return 0

        complete_tree, extant_tree, collapsed_nodes, leaves = stg.generate_newick_trees()       
        stg.write_events_file(events_file)
        stg.write_lengths(lengths_file, complete_tree, extant_tree)
        
        with open(complete_tree_file, "w") as f:
            assert complete_tree is not None
            f.write(complete_tree)

        with open(extant_tree_file, "w") as f:
            assert extant_tree is not None
            f.write(extant_tree)

        with open(collapsed_nodes_file, "w") as f:
            for k, v in collapsed_nodes.items():
                line = "\t".join([k, v]) + "\n"
                f.write(line)

        with open(leaves_file, "w") as f:
            f.write('### Leaf Names')
            for l in leaves:
                f.write(f'{l.name}\n')

        
        if advanced_mode != "i" and parameters["SCALE_TREE"] != 0:
            scaled_extant_tree_file = os.path.join(tree_folder, REDSCALEDTREE)
            scaled_events_file = os.path.join(tree_folder, REDSCALEDEVENTS)
            scaled_tree, scaled_events = stg.scale_trees(extant_tree, parameters["SCALE_TREE"])
            stg.write_scaled_files(scaled_tree, scaled_extant_tree_file,
                                   scaled_events, scaled_events_file)
        
        if advanced_mode == "b" or advanced_mode == "a":
            rates_file = os.path.join(tree_folder, RATES)
            stg.write_rates(rates_file)
            
        if advanced_mode == "s":
            #shift_s_file = os.path.join(tree_folder, "ShiftsSpeciations.tsv")
            #shift_e_file = os.path.join(tree_folder, "ShiftsExtinctions.tsv")
            cat_file = os.path.join(tree_folder, SHIFTSCATEGORIES)
            
            #stg.write_shifts(shift_s_file)
            #stg.write_shifts(shift_e_file)            
            stg.write_categories(cat_file)
            

    def G(self, parameters_file: Path, experiment_folder: Path, advanced_mode,
          root_genome: Path|None):
        """
        Simulate Genomes
        """
        parameters = af.prepare_genome_parameters(parameters_file)
        all_genomes = bool(parameters["ALL_GENOMES"])

        scaled_tree_file = experiment_folder / "T" / REDSCALEDTREE
        if(scaled_tree_file.exists() and parameters["SCALE_TREE"] == 0 or
           not scaled_tree_file.exists() and parameters["SCALE_TREE"] != 0):
            sys.exit("ERROR: the G mode SCALE_TREE parameter must match "
                     "the T mode SCALE_TREE setting!")

        events_file = experiment_folder / "T" / TREEEVENTS
        scaled_file = experiment_folder / "T" / SCALEDEVENTS
        genome_folder = experiment_folder / "G"

        if not events_file.exists():
            sys.exit(f'File "{events_file}" not found. Did you run T mode?')

        shutil.rmtree(genome_folder)
        genome_folder.mkdir()
        shutil.copy(parameters_file, genome_folder)

        genomes_folder = genome_folder / "Genomes"
        gene_families_folder = genome_folder / "Gene_families"

        seed_generators(parameters["SEED"], genome_folder / GSEED,
                        seed_G_generators)

        gss = GenomeSimulator(parameters, events_file, root_genome, all_genomes)

        if advanced_mode == "0":
            gss.run()

        elif advanced_mode == "u":

            rates_folder = experiment_folder / "CustomRates"
            gss.read_rates(rates_folder)
            gss.run_u()

        elif advanced_mode == "f":

            #gss.run_f_debug() # FIX
            gss.run_f()

        elif advanced_mode == "m":

            gss.run_m()

        elif advanced_mode == "i":

            gss.run_i()

        # We write the output

        print("Writing Genomes")

        if advanced_mode == "f":
            gss.write_genomes(genomes_folder, True, False)
            if all_genomes:
                gss.write_genomes(genome_folder / "All_genomes", True, True)

            gss.write_gene_family_lengths(genome_folder)

        else:
            gss.write_genomes(genomes_folder, False, False)
            if all_genomes:
                gss.write_genomes(genome_folder / "All_genomes", False, True)

        if advanced_mode == "i":
            print("Writing interactomes")
            gss.write_interactomes(genomes_folder)

        if advanced_mode == "m":
            print("Writing Family rates")
            gss.write_family_rates(genome_folder)
        
        print("Writing Gene Families")
       
        gss.write_gene_family_events(gene_families_folder)

        if parameters["PROFILES"] == 1:
            print("Writing Profiles")
            profiles_folder = os.path.join(genome_folder, "Profiles")
            gss.write_profiles(profiles_folder)
                        
        if parameters["GENEORDER_EVENTS_PER_BRANCH"] == 1:
            scale = parameters["SCALE_TREE"]
            print("Writing Events Per Branch")
            folder = genome_folder / "Geneorder_events_per_branch"
            gss.write_geneorder_events_per_branch(folder, scale, scaled_file,
                                                  events_file)

        if parameters["EVENTS_PER_BRANCH"] == 1:
            scale = parameters["SCALE_TREE"]
            print("Writing Events Per Branch")
            events_per_branch_folder = genome_folder / "Events_per_branch"
            gss.write_events_per_branch(events_per_branch_folder, scale,
                                        scaled_file, events_file)
            
        if parameters["GENE_TREES"] == 1 and parameters["RECONCILED_TREES"] == 1:
            print("Writing Gene Trees")
            gene_trees_folder = genome_folder / "Gene_trees"
            gss.write_gene_trees(gene_trees_folder, reconciliations=True)

        elif parameters["GENE_TREES"] == 1 and parameters["RECONCILED_TREES"] == 0:
            print("Writing Gene Trees")
            gene_trees_folder = genome_folder / "Gene_trees"
            gss.write_gene_trees(gene_trees_folder, reconciliations=False)

        elif parameters["GENE_TREES"] == 0 and parameters["RECONCILED_TREES"] == 1:
            print("Writing Gene Trees")
            gene_trees_folder = genome_folder / "Gene_trees"
            gss.write_gene_trees(gene_trees_folder, reconciliations=True, gene_trees=False)

        if advanced_mode == "f":    
            print("Writing Divisions")
            gss.init_divisions()            # This creates the divisions at the root,
            all_genomes = gss.redo_events_for_divisions() # This reruns the simulation forward
            division_trees_folder = genome_folder / "Division_trees"
            gss.write_division_trees(division_trees_folder)
            gss.write_pieces_coordinates(genomes_folder)
            if all_genomes:
                gss.write_pieces_coordinates(genome_folder / "All_genomes",
                                             all_genomes)

            gss.write_division_lengths(genome_folder)

            if root_genome:
                gss.write_gene_family_info(genome_folder) # This function should probably disappear FIX
                gss.write_genome_info(genome_folder)
            

    def S(self, parameters_file: Path, experiment_folder: Path,
          advanced_mode: str, num_threads: int, fasta_file: Path|None):
        """
        Simulate Sequences
        """
        genome_folder = experiment_folder / "G"
        if not genome_folder.is_dir():
            sys.exit(f'Directory "{genome_folder}" does not exist. '
                     f'Did you run G mode?')

        parameters = af.prepare_sequence_parameters(parameters_file)

        #Create the directories
        gene_trees_folder = genome_folder / "Gene_trees"
        sequences_folder = experiment_folder / "S"
        genesequences_folder = sequences_folder / "Genes"

        seed_generators(parameters["SEED"], sequences_folder / SSEED,
                        seed_S_generators)

        shutil.rmtree(sequences_folder)
        genesequences_folder.mkdir(parents=True)
        shutil.copy(parameters_file, sequences_folder)

        print("Preparing simulator of sequences")

        ss = SequenceSimulator(parameters, force_nuc_model=bool(fasta_file))

        if advanced_mode == "0":

            try:
                complete_trees = [x.replace(PRUNEDTREEsuffix, COMPLETETREEsuffix)
                                  for x in os.listdir(gene_trees_folder)
                                  if PRUNEDTREEsuffix in x]
            except FileNotFoundError:
                sys.exit(f'Directory "{gene_trees_folder}" does not exist. '
                         f'Did you run G mode?')
                
            if num_threads < 2:
                for tree_file in complete_trees:
                    tree_path = os.path.join(gene_trees_folder, tree_file)
                    if parameters["VERBOSE"] == 1:
                        print("Simulating sequence for gene family %s" % tree_file.split("_")[0])
                    ss.run(Path(tree_path), genesequences_folder, parameters["VERBOSE"] == 1)
                    af.write_pruned_sequences(tree_path.replace(COMPLETETREEsuffix,
                                                                PRUNEDTREEsuffix),
                                              genesequences_folder)

            else:
                with ProcessPoolExecutor(max_workers=num_threads) as executor:
                    futures: dict[str, Future[None]] = {}
                    for tree_file in complete_trees:
                        tree_path = os.path.join(gene_trees_folder, tree_file)
                        futures[tree_path] = executor.submit(ss.run, Path(tree_path),
                                                             genesequences_folder,
                                                             parameters["VERBOSE"] == 1)

                    for tree_path, future in futures.items():
                        future.result()
                        af.write_pruned_sequences(tree_path.replace(COMPLETETREEsuffix,
                                                                    PRUNEDTREEsuffix),
                                                  genesequences_folder)

        elif advanced_mode == "u":

            # First we obtain the rates-multiplier

            ss.obtain_rates_multipliers(experiment_folder / "CustomRates" / GTSUBSTITUTIONRATES,
                                        experiment_folder / "CustomRates" / STSUBSTITUTIONRATES)

            # And we save it

            ss.write_rates_sttree(experiment_folder / "T" / COMPLETETREE,
                                  experiment_folder / "T" / RATESTREE)

            complete_trees = [x for x in os.listdir(gene_trees_folder)
                              if COMPLETETREEsuffix in x]

            for tree_file in complete_trees:
                tree_path = os.path.join(gene_trees_folder, tree_file)
                if parameters["VERBOSE"] == 1:
                    print("Simulating sequence for gene family %s" % tree_file.split("_")[0])
                ss.run_u(tree_path, genesequences_folder)
                af.write_pruned_sequences(tree_path.replace(COMPLETETREEsuffix, PRUNEDTREEsuffix),
                                          genesequences_folder)
                
        elif advanced_mode == "s":

            # First we simulate the sequence shifts in the Complete Tree
            
            ss.simulate_shifts(experiment_folder / "T" / TREEEVENTS)
            ss.write_shift_events(experiment_folder / "S" / SHIFTEVENTS)
            ss.write_categories(experiment_folder / "S" / CATEGORIES)
            # We create a new Species Tree with the branch modified to reflect these changes
            
            ss.write_substitution_scaled_stree(experiment_folder / COMPLETETREE,
                                               experiment_folder / EXTANTTREE,
                                               experiment_folder / SUBSTITUTIONSCALEDCOMPLETETREE,
                                               experiment_folder / SUBSTITUTIONSCALEDEXTANTTREE,
                                               experiment_folder / BRANCHWISERATES)

            
            # We modify the length of the complete gene trees according to the previous table
            
            if int(parameters["SCALE_GENE_TREES"]) == 1:

                
                complete_trees = [x for x in os.listdir(gene_trees_folder)
                                  if COMPLETETREEsuffix in x]            
                scaled_trees_folder = experiment_folder / "S/SubstitutionScaledTrees/"
                scaled_trees_folder.mkdir()

                for tree in complete_trees:
                    if parameters["VERBOSE"] == 1:
                        print("Scaling trees for gene family %s" % tree.split("_")[0])
                    ntree = ss.write_effective_gtree(experiment_folder / "G/Gene_trees" / tree, 
                                                     experiment_folder / "G/Gene_families" / (tree.split("_")[0] + GENEFAMEVENTSsuffix))

                    # We write the trees
                    if ntree != None:
                        with open(scaled_trees_folder / (tree.split("_")[0] + SUBSTITUTIONSCALEDTREEsuffix), "w") as f:
                            f.write(ntree)

            # Now we simulate the sequences    

            if int(parameters["SIMULATE_SEQUENCE"]) == 1 and int(parameters["SCALE_GENE_TREES"]) == 0:
                print("If you want to simulate the sequence you need to set SCALE_GENE_TREES to 1 first")
            elif int(parameters["SIMULATE_SEQUENCE"]) == 1 and int(parameters["SCALE_GENE_TREES"]) == 1:
                complete_trees = [x for x in scaled_trees_folder.iterdir() if "nwk" in str(x)]
                scaled_fastas_folder = sequences_folder / "Fastas"
                scaled_fastas_folder.mkdir()
                for tree_file in complete_trees:
                    if parameters["VERBOSE"] == 1:
                        print(f"Simulating sequence for gene family {str(tree_file).split('_')[0]}")

                    ss.run(scaled_trees_folder / tree_file, scaled_fastas_folder)
                    tree_path = os.path.join(gene_trees_folder, tree_file)
                    af.write_pruned_sequences(tree_path.replace(SUBSTITUTIONSCALEDTREEsuffix, PRUNEDTREEsuffix),
                                              scaled_fastas_folder, True)
            

        elif advanced_mode == "f":

            complete_trees = [x for x in os.listdir(gene_trees_folder)
                              if COMPLETETREEsuffix in x]
            divisionsequences_folder = sequences_folder / "Divisions"
            divisionsequences_folder.mkdir()

            gf_lengths: dict[str, int] = dict()

            with open(genome_folder / GENEFAMILYLENGTHS) as f:
                f.readline()
                for line in f:
                    gf, l = line.strip().split("\t")
                    gf_lengths[gf] = int(l)

            id_to_seq = None
            did_to_seq = None
            if fasta_file:
                try:
                    id_to_seq, did_to_seq = af.read_nucleotide_sequences(fasta_file, genome_folder)
                except af.MissingInfoFileError as e:
                    sys.exit(f'Expected file "{e}" which does not exist.'
                             f'Did you run Gf mode?')
            
            if parameters["SEQUENCE"] != "nucleotide":
                print("Sequence mode will be changed to codon for full compatibility with Sf mode")

                    #Generate the sequences for the gene trees:
            if num_threads and num_threads > 1:
                print(f"Using {num_threads} threads in parallel.")
                n = len(complete_trees)
                with multiprocessing.Pool(processes=num_threads) as pool:
                    pool.starmap(simulate_sequences_on_tree,
                                 zip(complete_trees, [gene_trees_folder]*n,
                                     [genesequences_folder]*n, [ss]*n,
                                     [gf_lengths]*n, [id_to_seq]*n,
                                     [parameters["VERBOSE"]]*n))
            else:
                id_to_seq=None
                for tree_file in complete_trees:
                    simulate_sequences_on_tree(tree_file, gene_trees_folder,
                                               genesequences_folder, 
                                               ss, gf_lengths, id_to_seq,
                                               parameters["VERBOSE"])
            
            print("Writing division sequences")

                    #Generate the sequences for the intergene division trees:
            division_trees_folder = Path(genome_folder, "Division_trees")
            division_trees = [x.name for x in division_trees_folder.iterdir()
                              if COMPLETETREEsuffix in x.name]

            division_lengths: dict[str, int] = dict()

            with open(genome_folder / DIVISIONLENGTHS) as f:
                f.readline()
                for line in f:
                    did, length = line.strip().split("\t")
                    division_lengths[did] = int(length)

            if num_threads and num_threads > 1:
                n = len(division_trees)
                with multiprocessing.Pool(processes=num_threads) as pool:
                    pool.starmap(simulate_sequences_on_tree,
                                 zip(division_trees,
                                     [division_trees_folder]*n,
                                     [divisionsequences_folder]*n, [ss]*n,
                                     [division_lengths]*n, [did_to_seq]*n,
                                     [parameters["VERBOSE"]]*n))
            else:
                for tree_file in division_trees:
                    simulate_sequences_on_tree(tree_file,
                                               division_trees_folder,
                                               divisionsequences_folder, 
                                               ss, division_lengths, did_to_seq,
                                               parameters["VERBOSE"])
            

            # Now we write all the fastas and we create a dictionary to recover the sequences

            node2genef2seq: dict[str, dict[str, str]] = defaultdict(dict) # To keep the genes
            node2divf2seq: dict[str, dict[str, str]] = defaultdict(dict)  # To keep the divisions
            
            gene_fastas = [x for x in os.listdir(genesequences_folder)
                           if COMPLETEsuffix in x]

            for gene_fasta in gene_fastas:
                gf = gene_fasta.split("_")[0]
                for name, seq in af.fasta_reader(genesequences_folder / gene_fasta):
                    node2genef2seq[name[1:]][gf] = seq


            division_fastas = [x for x in os.listdir(divisionsequences_folder)
                               if COMPLETEsuffix in x]

            for division_fasta in division_fastas:
                df = division_fasta.split("_")[0]
                for name, seq in af.fasta_reader(divisionsequences_folder / division_fasta):
                    node2divf2seq[name[1:]][df] = seq
            
            
            # Finally we write the whole genomes
            
            print("Writing whole genomes")

            genomes_folder = Path(genome_folder, "Genomes")
            genomeseq_folder = Path(sequences_folder, "Genomes")
            
            os.mkdir(genomeseq_folder)

            pieces_files = [d for d in genomes_folder.iterdir()
                            if str(d).endswith(PIECESsuffix)] # could be renamed to COORDINATES.tsv

            leaves_file = experiment_folder / "T" / LEAVES
            leaves = af.get_leaves_from_file(leaves_file)
    
            for pieces_file in pieces_files:
                write_whole_genome(pieces_file, ss, sequences_folder,
                                   genomeseq_folder, leaves)

            whole_genome_to_GFF(pieces_files,
                                Path(sequences_folder, GENOMES))
            whole_genome_to_GFF(pieces_files,
                                Path(sequences_folder, LEAFGENOMES),
                                leaves)


