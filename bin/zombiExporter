#!/usr/bin/env python3
"""
Export information from a Zombi simulation to other formats, including the
calculation of broken adjacencies on edges, and scenarios of events between
pairs of genomes.
"""
import json
import sys
import argparse
from typing import Iterator, NamedTuple
import networkx as nx
import pandas as pd

from pathlib import Path
from Bio import SeqIO
from Bio.SeqRecord import SeqRecord
from Bio.Seq import Seq
from collections import namedtuple
from collections import defaultdict as ddict

from zombi.AuxiliarFunctions import get_genome, get_last_genome
from zombi.AuxiliarFunctions import get_directed_tree
from zombi.Events import AFER, LFER, LFER_B, LFER_F, LOSS, ORIG, POS, TDUP
from zombi.Events import TWO_BP_EVENTS, DUP
from zombi.Export import get_genes, get_leaf_names, random_seq
from zombi.Export import whole_genome_to_GFF
from zombi.Filenames import GENEFAMEVENTSsuffix, GENEORDEREVENTSsuffix
from zombi.Filenames import PIECESsuffix, GENOMEsuffix, COMPLETEsuffix
from zombi.Filenames import COMPLETETREE
    
    
# Constants
GENOMES = 'G/Genomes'
FAMILIES = 'G/Gene_families'
GENES = 'S/Genes'

CoordPair = namedtuple('CoordPair', ['start', 'end', 'strand'])


# FUNCTIONS ___________________________________________________________________


def getPosOrthologs(eventsfile, fam='') -> list[list[tuple[str, str]]]:
    """
    Return sets of positional orthologs. If fam is not empty, prepend it
    to the gene name.

    Notes
    -----
        Note that the notion of positional ortholog is ambiguous in the
        presence of tandem duplications. In this case, the leftmost copy is
        considered the original.

    Returns
    -------
        list[list[tuple[str, str]]]
            Lists constaining position orthologs of the form (node, gene_id)
    """
    #Build a directed tree from the given events file. Remove edges for each
    #U or D event. The surviving leaves in each connected component form a
    #set of positional orthologs.
    # 
    #Each line of the file (after the header) is a tab-separated
    #list of the form:
    #   TIME EVENT_CHARACTER NODE_SPECIFIER
    #
    #Each pair of elements in the NODE_SPECIFIER is a semicolon-separated list
    #of the form:
    #   SPECIESTREE_NODE;GENE_ID
    #where there is a new GENE_ID for each node of the gene tree.
    #
    #See https://github.com/AADavin/Zombi/wiki/Generating-Genomes#output for
    #details.
    G = nx.DiGraph()
    with open(eventsfile) as f:
        f.readline()                       #header
        for line in f:
            _, event, nodespec = line.strip().split('\t')
            if event == 'O':                            #root of gene tree
                G.add_node((nodespec, f'{fam}1'))

            elif event == 'S' or event == 'T':          #speciation or transfer
                p, c1, c2 = getNodeNames(nodespec, fam)
                G.add_edge(p, c1)
                G.add_edge(p, c2)

            elif event == 'U' or event == 'D':          #duplication
                p, c1, c2 = getNodeNames(nodespec, fam)
                G.add_edge(p, c1)          #original copy is the first
                G.add_node(c2)

            elif event == 'F':                          #surviving leaf
                l = getNodeName(nodespec, fam)
                G.nodes[l]['leaf'] = True

    #Traverse the connected components, keeping the leaves:
    polists = []
    for component in nx.weakly_connected_components(G):
        leaves = [n for n in component if 'leaf' in G.nodes[n]]
        if len(leaves):
            polists.append(leaves)

    return polists


def getNodeNames(nodespec: str, prefix: str) \
    -> tuple[tuple[str, str], tuple[str, str], tuple[str, str]]:
    """
    Return the node names. Return

    (parent_species_node, parent_gene_node),
    (child1_species_node, child1_gene_node),
    (child2_species_node, child2_gene_node)
    """
    pn, p, cn1, c1, cn2, c2 = nodespec.split(';')
    return (pn, prefix+p), (cn1, prefix+c1), (cn2, prefix+c2)


def getNodeName(nodespec: str, prefix: str) -> tuple[str, str]:
    """
    Return the (speciestree_node, genetree_node) tuple.
    """
    snode, nid = nodespec.split(';')
    return (snode, prefix+nid)


GFFHEADER = ('##gff-version 3\n'
             '#File intended for use with FFGC. IDs of elements are the\n'
             '#gene, transcript, and exon names.\n'
             '#(homologous) block information was encoded into the file\n'
             '#named "families.txt".')
BEDHEADER = ('#Blocks written with the name column containing the family id.\n'
             '#The seventh column contains the gene name.')
COORDNOTE = ('#Intergene regions were ignored when creating this file, so\n'
             '#gene coordinates are contiguous, and may not correspond to the\n'
             '#simulated coordinates (use -p for accurate coordinates).')

def processGeneFamilies(fam2id2genome2rec: dict[str, dict[str, dict[str, SeqRecord]]],
                        projdir: Path, outdir: Path, gff=True,
                        useintergenic=False) -> dict[str, dict[str, CoordPair]]:
    """
    For each gene family, create a GFF or BED file with the intervals of the
    genes in the family. Also create a FASTA file with genome sequence.

    Parameters
    ----------
    fam2id2genome2rec : dict[str, dict[str, dict[str, SeqRecord]]]
        Map family id to gene id to genome to SeqRecord.
    gff : bool
        If True, create GFF files. If False, create BED files.
    useintergenic : bool
        If True, use intergenic regions when calculating gene coordinates
        (from the _PIECES.tsv files).

    Returns
    -------
    dict[str, dict[str, CoordPair]]
        Map family id to gene id to start and end coordinates.
    """
    genomesdir = projdir / GENOMES
    suffix = GENOMEsuffix
    if useintergenic:
        suffix = PIECESsuffix

    fam2recid2pos: dict[str, dict[str, CoordPair]] = ddict(dict)
    leaves = get_leaf_names(projdir)
    for genome in leaves:
        i = 1
        lines = ''
        genomesequence = SeqRecord(Seq(''))
        gfile = genomesdir / f'{genome}{suffix}'
        for g in iterGenesFromGenome(gfile, useintergenic):
            #TODO: the following is a workaround for the case when a gene
            #is the last surviving representative. The sequence is not
            #simulated by Zombi in this case, at present!
            if g.family not in fam2id2genome2rec:
                fam2id2genome2rec[g.family][g.gid][genome] = random_seq()
                print(f'Loner gene {g.family}_{g.gid} not simulated in '
                      f'{genome}. ')

            rec = fam2id2genome2rec[g.family][g.gid][genome]
            genomesequence += rec
            assert rec.id

            if useintergenic:
                start = g.start
                end = g.end
            else:
                start = i
                end = i + len(rec) - 1

            fam2recid2pos[g.family][rec.id] = CoordPair(start, end, g.strand)

            if gff:
                lines += (f'{genome}\tZombi\tCDS\t{start}\t{end}\t'
                          f'.\t{g.strand}\t0\tID={g.family}_{g.gid}\n')
            else:
                lines += (f'{genome}\t{start+1}\t{end}\t{g.family}\t0\t'
                          f'{g.strand}\t{g.family}_{g.gid}\n')
            i += len(rec)

        if not useintergenic:
            lines = COORDNOTE + '\n' + lines
        if gff:
            lines = GFFHEADER + '\n' + lines
            outfile = outdir / f'{genome}.gff'
        else:
            lines = BEDHEADER + '\n' + lines
            outfile = outdir / f'{genome}.bed'

        with open(outfile, 'w') as f:
            f.write(lines)

        assert len(genomesequence) == i - 1
        genomesequence.id = genome
        genomesequence.description = ''
        SeqIO.write(genomesequence, outdir / f'{genome}.fa', 'fasta')

    return fam2recid2pos


class GeneTuple(NamedTuple):
    family: str
    gid: str
    strand: str
    start: int
    end: int

def iterGenesFromGenome(gfile: Path, useintergenic: bool) -> Iterator[GeneTuple]:
    df = pd.read_csv(gfile, sep='\t', comment='#').astype(str)
    if useintergenic:
        for family, type, geneid, _, start, end, strand in df.itertuples(index=False):
            if type == 'Gene':
                yield GeneTuple(family, geneid, strand, int(start), int(end))
    else:
        for _, family, strand, geneid in df.itertuples(index=False):
            yield GeneTuple(family, geneid, strand, 0, 0)


def getEventLines(eventfile: Path, genomesdir: Path,
                  parent: str, child: str) -> list[tuple[str, float, str, str]]:
    """
    Return tuples describing the broken adjacencies for the given event file.

    Notes
    -----
    - Assumes single chromosome genomes.
    - Assumes that chromosomes are circular.

    Parameters
    ----------
    eventfile : Path
        The path to the gene order events file for a branch.
    genomesdir : Path
        The directory containing the genome files.
    parent : str
        The parent node on the branch.
    child : str
        The child node on the branch for which we're getting broken adjacencies.
    """
    retlist = []
    genome, _ = get_last_genome(f'{genomesdir}/{parent}-')

    df = pd.read_csv(eventfile, sep='\t')
    idiff = 0
    for i, time, event, bps, _, chrom in df.itertuples():
        #`chrom` is not currently used since it doesn't exist in the
        #genome files!
        if isinstance(bps, int):
            bps = [bps]
        else:
            bps = list(map(int, bps.split(',')))

        if event == AFER:
            if retlist and time == retlist[-1][1]:  #replacement transfer
                assert retlist[-1][2] == LOSS
                gene1, gene2 = prevgenome[bps[0]-1], prevgenome[bps[0] % len(prevgenome)]
                retlist[-1] = (child, time, event, f'{gene1}|{gene2}')
                idiff += 1
            else:
                gene1, gene2 = genome[bps[0]-1], genome[bps[0] % len(genome)]
                retlist.append((child, time, event, f'{gene1}|{gene2}'))

        elif event == ORIG:
            gene1, gene2 = genome[bps[0]-1], genome[bps[0] % len(genome)]
            retlist.append((child, time, event, f'{gene1}|{gene2}'))

        elif event == TDUP:
            gene1, gene2 = genome[bps[1]], genome[(bps[1]+1) % len(genome)]
            retlist.append((child, time, event, f'{gene1}|{gene2}'))

        elif event == LFER or event == LFER_F or event == LFER_B:
            retlist.append((child, time, event, ''))  #no broken adjacencies

        elif event in TWO_BP_EVENTS:
            gene1, gene2 = genome[bps[0]-1], genome[bps[0]]
            gene3, gene4 = genome[bps[1]], genome[(bps[1]+1) % len(genome)]
            retlist.append((child, time, event, f'{gene1}|{gene2},{gene3}|{gene4}'))

        elif event == POS:
            if bps[2] != bps[0]:   #didn't put it back in the same place
                gene1, gene2 = genome[bps[0]-1], genome[bps[0]]
                gene3, gene4 = genome[bps[1]], genome[(bps[1]+1) % len(genome)]
                gene5, gene6 = genome[bps[2]-1], genome[bps[2] % len(genome)]
                retlist.append((child, time, event,
                               f'{gene1}|{gene2},{gene3}|{gene4},{gene5}|{gene6}'))
            else:
                retlist.append((child, time, event, ''))  #no broken adjacencies
        elif event == DUP:
            gene1, gene2 = genome[bps[2]-1], genome[bps[2] % len(genome)]
            retlist.append((child, time, event, f'{gene1}|{gene2}'))

        else:
            raise ValueError(f'Unknown event type "{event}" in file '
                             f'"{eventfile}".')

        prevgenome = genome
        genome = get_genome(genomesdir / f'{child}-{i-idiff}{GENOMEsuffix}')

    return retlist

    
# _____________________________________________________________________________


def main():
    desc = 'Export simulated files to other formats.'
    parser = argparse.ArgumentParser(description=desc)
    subparsers = parser.add_subparsers(title='subcommands')

    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument('PROJ_DIR', type=Path,
                        help='project directory')

    outdir_p = argparse.ArgumentParser(add_help=False)
    outdir_p.add_argument('OUT_DIR', type=Path,
                           help='output files to this directory')

    gfhelp = 'Export the gene orders as a single GFF file.'
    p_gf = subparsers.add_parser('gff', aliases=['gf'],
                                 parents=[parent],
                                 description=gfhelp, help=gfhelp)
    pohelp = 'Export the positional ortholog sets.'
    p_po = subparsers.add_parser('posortho', aliases=['po'],
                                 parents=[parent],
                                 description=pohelp, help=pohelp)
    ffhelp = 'Export extant leaf genomes and sequences for use with FFGC.'
    p_ff = subparsers.add_parser('ffgc', aliases=['ff'],
                                 parents=[parent, outdir_p],
                                 description=ffhelp, help=ffhelp)
    bdhelp = 'Export the blocks as a BED file and FASTA files.'
    p_bd = subparsers.add_parser('bed', aliases=['bd'],
                                 parents=[parent, outdir_p],
                                 description=bdhelp, help=bdhelp)
    duhelp = 'Make a TSV file mapping family id to number of duplications.'
    p_du = subparsers.add_parser('dupinfo', aliases=['du'], parents=[parent],
                                 description=duhelp, help=duhelp)
    bphelp = 'Export the adjacencies broken for each edge.'
    p_bp = subparsers.add_parser('breakpoints', aliases=['bp'],
                                 parents=[parent],
                                 description=bphelp, help=bphelp)

    p_gf.add_argument('OUT_FILE', type=Path,
                      help='output file')
    p_gf.add_argument('-p', '--pieces', action='store_true',
                      help=f'use {PIECESsuffix} files instead {GENOMEsuffix} files')

    p_po.add_argument('OUT_FILE', type=Path,
                      help='the JSON file')
    p_po.add_argument('-n', '--no-family', action='store_true',
                      help='exclude family id from the gene name')

    p_bd.add_argument('-p', '--pieces', action='store_true',
                      help=f'use {PIECESsuffix} files instead {GENOMEsuffix} files')

    p_du.add_argument('OUT_FILE', type=Path,
                      help='output TSV file')
 
    p_bp.add_argument('OUT_FILE', type=Path,
                      help='the TSV file')
 
    p_gf.set_defaults(func=export_GFF)
    p_po.set_defaults(func=export_PositionalOrthologs)
    p_ff.set_defaults(func=export_FFGC)
    p_bd.set_defaults(func=export_BED)
    p_du.set_defaults(func=export_DupInfo)
    p_bp.set_defaults(func=export_Breakpoints)

    args = parser.parse_args()
    
    if 'func' not in vars(args):
      parser.print_help()
      sys.exit()

    args.func(args) 


#MAIN:    __    __    __    __    __    __    __    __    __    __    __    __
#__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \_


def export_PositionalOrthologs(args):
    """
    Make a TSV file with the positional orthologs.
    """
    proj_dir: Path = args.PROJ_DIR
    out_file: Path = args.OUT_FILE
    no_family = args.no_family

    #Make sure the directory for the output file exists
    out_file.parent.mkdir(parents=True, exist_ok=True)

    #For each gene family, get the positional orthologs and output them in
    #JSON format:
    familiesdir = proj_dir / FAMILIES
    eventssuffix = GENEFAMEVENTSsuffix
    fam2orthosets = {}
    for famfile in familiesdir.iterdir():
        if famfile.name.endswith(eventssuffix):
            fam = famfile.name.replace(eventssuffix, '')
            fam2orthosets[fam] = getPosOrthologs(famfile,
                                                 '' if no_family else fam+'_')

    with open(out_file, 'w') as f:
        json.dump({'comment': 'Map gene family to positional ortholog lists. '
                              'Each list has pairs (species, geneid). Produced '
                              'by zombiExporter.', 'data': fam2orthosets},
                  f, indent=2)
        #f.write('{"comment": "Map family to positional ortholog lists. Each '
        #        'list has pairs (species, geneid). Produced by zombiExporter."'
        #f.write('{"comment": "Map family to positional ortholog lists. Each '
        #        'list has pairs (species, geneid). Produced by zombiExporter."'
        #        ',\n"data": {\n')
        #left = len(fam2orthosets)
        #for fam, orthosets in fam2orthosets.items():
        #    left -= 1
        #    if len(orthosets) == 0:
        #        continue

        #    f.write(f'"{fam}": ')
        #    json.dump(orthosets, f)
        #    if left:
        #        f.write(',')
        #    f.write('\n')

        #f.write('}}\n')


def export_FFGC(args):
    """
    Export the leaf genomes and sequence for use with FFGC:
        1. a GFF file for each genome, having an interval for each gene
        2. a fasta file for each of the gene orders, where the fasta file
           contains the entire genome sequence
        3. a family file where each line is a space-separated list of genes
           in the same family
    """
    proj_dir: Path = args.PROJ_DIR
    out_dir: Path = args.OUT_DIR

    #Make the directory if it doesn't exist
    out_dir.mkdir(parents=True, exist_ok=True)

    #Read the gene sequences
    fam2id2genome2rec = get_genes(proj_dir / GENES, COMPLETEsuffix)

    fam2recid2pos = processGeneFamilies(fam2id2genome2rec, proj_dir, out_dir,
                                        gff=True)

    #Write the family file
    with open(out_dir / 'families.txt', 'w') as f:
        for family, id2genome2rec in fam2id2genome2rec.items():
            famstr = ''
            for id, genome2rec in id2genome2rec.items():
                for genome, rec in genome2rec.items():
                    if rec.id in fam2recid2pos[family]:
                        famstr += (f'{family}_{id}|'
                                   f'{fam2recid2pos[family][rec.id].start}:'
                                   f'{fam2recid2pos[family][rec.id].end}|'
                                   f'chromosome|{genome}|'
                                   f'strand|'
                                   f'{fam2recid2pos[family][rec.id].strand} ')

            if famstr:
                f.write(famstr.strip() + '\n')


def export_GFF(args):
    """
    Write a GFF will all intervals of the genome.
    """
    proj_dir: Path = args.PROJ_DIR
    out_file: Path = args.OUT_FILE
    use_pieces = args.pieces
    if not use_pieces:
        raise NotImplementedError(f'Exporting {GENOMEsuffix} to GFF is not yet '
                                  'supported.  Use the -p option.')

    genomesdir = proj_dir / GENOMES

    #Make sure the directory for the output file exists
    out_file.parent.mkdir(parents=True, exist_ok=True)

    piecesfiles = [x for x in genomesdir.iterdir()
                   if x.name.endswith(PIECESsuffix)]

    if not piecesfiles:
        raise ValueError(f'No {PIECESsuffix} files found in "{genomesdir}"')

    whole_genome_to_GFF(piecesfiles, out_file)


def export_BED(args):
    """
    For each genome, create a BED with all intervals of the genome, along with
    a FASTA file containing the genome sequence.
    """
    proj_dir: Path = args.PROJ_DIR
    out_dir: Path = args.OUT_DIR
    use_pieces = args.pieces

    #Make the directory if it doesn't exist
    out_dir.mkdir(parents=True, exist_ok=True)

    #Read the gene sequences
    fam2id2genome2rec = get_genes(proj_dir / GENES, COMPLETEsuffix)

    processGeneFamilies(fam2id2genome2rec, proj_dir, out_dir, gff=False,
                        useintergenic=use_pieces)


def export_DupInfo(args):
    """
    Make a TSV file mapping family id to number of duplications.
    The columns are:
        FAMILY DUPTOTAL DUPS TANDEMDUPS    
    """
    proj_dir: Path = args.PROJ_DIR
    out_file: Path = args.OUT_FILE

    #Make sure the directory for the output file exists
    out_file.parent.mkdir(parents=True, exist_ok=True)

    #For each gene family, get the number of duplications:
    familiesdir = proj_dir / FAMILIES
    eventssuffix = GENEFAMEVENTSsuffix
    fam2dups = {}
    for famfile in familiesdir.iterdir():
        if famfile.name.endswith(eventssuffix):
            fam = famfile.name.replace(eventssuffix, '')
            with open(famfile) as f:
                f.readline()                       #header
                dups = 0
                tandemdups = 0
                for line in f:
                    _, event, _ = line.strip().split('\t')
                    if event == 'U':
                        dups += 1
                    elif event == 'D':
                        tandemdups += 1

            fam2dups[fam] = (dups, tandemdups)

    with open(out_file, 'w') as f:
        f.write('FAMILY_ID\tTOTAL_DUPS\tDUPS\tTANDEM_DUPS\n')
        for fam, (dups, tandemdups) in fam2dups.items():
            f.write(f'{fam}\t{dups+tandemdups}\t{dups}\t{tandemdups}\n')


def export_Breakpoints(args):
    """
    Export the adjacencies broken for each edge as a TSV file.
    The columns are:
        BRANCH TIME EVENT BROKEN_ADJACENCIES

    where EVENT is the event type, BRANCH is the pendant node name, and
    BROKEN_ADJACENCIES is a comma-separated list of adjacencies each having
    the format "gene1|gene2", where gene1 and gene2 are the family identifiers.
    """
    proj_dir: Path = args.PROJ_DIR
    out_file: Path = args.OUT_FILE
    
    gdir = proj_dir / 'G'
    genomesdir = gdir / 'All_genomes'
    message = ('Run "zombi G" with "ALL_GENOMES" and '
               '"GENEORDER_EVENTS_PER_BRANCH" activated.')
    if not genomesdir.exists():
        sys.exit(f'ERROR: {genomesdir} does not exist. {message}')
    
    eventsdir = gdir / 'Geneorder_events_per_branch'
    if not eventsdir.exists():
        sys.exit(f'ERROR: {eventsdir} does not exist. {message}')

    treefile = proj_dir / 'T' / COMPLETETREE
    tree = get_directed_tree(treefile)

    #For each branch, read the events file and calculate the broken adjacencies:
    branch2events: dict[str, list[tuple]] = {}
    for eventfile in eventsdir.iterdir():
        branch = eventfile.name.replace(GENEORDEREVENTSsuffix, '')
        if branch == 'Initial':
            continue
        elif branch == 'Root':
            parent = 'Initial'
        else:
            parent = list(tree.predecessors(branch))[0]

        branch2events[branch] = getEventLines(eventfile, genomesdir, parent, branch)

    #Write the output file
    with open(out_file, 'w') as f:
        f.write('BRANCH\tTIME\tEVENT\tBROKEN_ADJACENCIES\n')
        for branch, lines in branch2events.items():
            for line in lines:
                f.write('\t'.join(map(str, line)) + '\n')


if __name__ == "__main__":
    main()                                           
