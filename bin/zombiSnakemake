#!/usr/bin/env python3
"""
Generate simulations across a range of parameters.

This script prepares a Snakemfile at the given project directory.  Snakemake
is then used to create the simulations.
"""
import argparse
import shutil
import sys

from pathlib import Path


# Constants


# FUNCTIONS ___________________________________________________________________




# _____________________________________________________________________________


def main():
  desc = 'Generate simulations across a range of parameters.'
  parser = argparse.ArgumentParser(description=desc)

  parser.add_argument('PROJ_DIR', type=Path,
                      help='project directory')

  args = parser.parse_args()
  proj_dir = args.PROJ_DIR

  #MAIN:    __    __    __    __    __    __    __    __    __    __    __    __
  #__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \__/  \_

  if not proj_dir.exists():
    proj_dir.mkdir(parents=True, exist_ok=True)

  #Copy the Snakefile from the template directory to the project directory
  workflow = Path(sys.prefix) / 'share/zombi/workflow/'
  snakefile = workflow / 'template/Snakefile_template.smk'
  if not snakefile.exists():
    sys.exit(f'Problem with installation: "{snakefile}" not found.')
        
  print(f'Copying files...', end=' ')
  shutil.copy(snakefile, Path(proj_dir) / 'Snakefile')

  #Copy the config file to the project directory
  configfile = workflow / 'config/config.yaml'
  if not configfile.exists():
    sys.exit(f'Problem with installation: "{configfile}" not found.')

  shutil.copy(configfile, proj_dir)

  #Copy the Parameters directory
  parameters = Path(sys.prefix) / 'share/zombi/Parameters'
  if not parameters.exists():
    sys.exit(f'Problem with installation: "{parameters}" not found.')

  shutil.copytree(parameters, Path(proj_dir) / 'Parameters')
  print(f'done.')

  print(f'To generate simulations, run snakemake in the project directory:\n'
        f'  `cd {proj_dir}`\n'
        f'  edit {proj_dir}/config.yaml\n'
        f'  `snakemake -c 1 --configfile config.yaml`')

if __name__ == "__main__":
    main()                                           
